# Copy to .env.production (server) — never commit real values.
# Local development needs none of this: `bun run local` writes .env.local with random secrets.

NODE_ENV=production
APP_URL=https://www.schimmel.com.pk

# PostgreSQL 15+ (17 recommended). Use TLS (?sslmode=require) for a managed database.
DATABASE_URL=postgres://ash:CHANGE_ME@db:5432/ash
DATABASE_POOL_MAX=10

# 32+ random bytes, e.g.  openssl rand -base64 48
# Signs the bot-quiz tokens and encrypts two-factor secrets. Changing it disables existing 2FA set-ups.
AUTH_SECRET=

# Client address for rate limiting. One reverse proxy (Caddy/nginx) in front: keep the defaults.
# Cloudflare in front: IP_SOURCE=cf-connecting-ip (and only accept traffic from Cloudflare).
IP_SOURCE=x-forwarded-for
TRUSTED_PROXY_HOPS=1

# Shared secret for the scheduler calling POST /api/cron/maintenance (every 10 minutes).
CRON_SECRET=

# Inbox that receives an email for every new application / message (optional).
STAFF_NOTIFY_EMAIL=courses@schimmel.com.pk

# ---- Gmail API (docs/GMAIL_SETUP.md) -------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=info@schimmel.com.pk
GMAIL_SENDER_NAME=Annemarie-Schimmel-Haus

# ---- WhatsApp Business Cloud API (docs/WHATSAPP_TEMPLATES.md) ------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# ---- Database seed (scripts/seed.ts) -------------------------------------
# Production must load the catalogue without synthetic applicants.
SEED_SAMPLES=false

# ---- Website assistant "Schimmel" (optional) --------------------------------
# One free LLM key is enough. Without one, Schimmel still answers from the site's own data.
# Groq: https://console.groq.com/keys   ·   Hugging Face: https://huggingface.co/settings/tokens
GROQ_API_KEY=
HF_TOKEN=
# CHAT_MODEL=llama-3.3-70b-versatile
